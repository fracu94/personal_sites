---
import { pathTo } from '../config';
const { article, featured = false } = Astro.props;
const date = article.data.pubDate.toLocaleDateString('it-IT', {day:'2-digit',month:'short',year:'numeric'});
---
<a class:list={['article-card', { featured }]} href={pathTo(`articles/${article.id}/`)}><div class="card-art" aria-hidden="true"><div class="orb"></div><span class="card-grid"></span></div><div class="card-content"><div class="eyebrow card-meta"><span>{article.data.category}</span><time datetime={article.data.pubDate.toISOString()}>{date}</time></div><h3>{article.data.title}</h3><p>{article.data.description}</p><span class="read-more">Leggi l'articolo ↗</span></div></a>
