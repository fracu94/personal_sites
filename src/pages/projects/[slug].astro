---
import Base from '../../layouts/Base.astro';import {getCollection,render} from 'astro:content';import {pathTo} from '../../config';export async function getStaticPaths(){return (await getCollection('projects',({data})=>!data.draft)).map(project=>({params:{slug:project.id},props:{project}}));}const {project}=Astro.props;const {Content}=await render(project);
---
<Base title={`${project.data.title} | Francesco Custureri`}><article class="post wrap"><a class="text-link" href={pathTo('projects/')}>← Tutti i progetti</a><header><p class="eyebrow">SELECTED PROJECT</p><h1>{project.data.title}</h1><p class="post-description">{project.data.description}</p><div class="tags">{project.data.tags.map(t=><span>{t}</span>)}</div></header><div class="prose"><Content/></div></article></Base>
