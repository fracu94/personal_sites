---
import Base from '../layouts/Base.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { getCollection } from 'astro:content';
import { identity, pathTo } from '../config';
const articles = (await getCollection('articles', ({data})=> !data.draft)).sort((a,b)=>b.data.pubDate.valueOf()-a.data.pubDate.valueOf()).slice(0,3);
const projects = (await getCollection('projects', ({data})=> !data.draft)).slice(0,3);
---
<Base><div class="assembly-progress" aria-hidden="true"><span></span></div><section class="intro-system wrap" aria-label="Presentazione"><div class="intro-top" data-intro><span>FC / SYSTEM 001</span><span>PORTFOLIO · 2026</span></div><div class="intro-grid" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></div><div class="intro-body"><div class="intro-mark" data-intro><img src={pathTo('brand/monogram-color.svg')} alt="" /></div><p class="intro-kicker" data-intro>INTELLIGENCE / TECHNOLOGY / PERSPECTIVES</p><h1 class="intro-title"><span class="intro-line"><span>FRANCESCO</span></span><span class="intro-line"><span>CUSTURERI<span class="intro-period">.</span></span></span></h1><div class="intro-bottom" data-intro><strong>AI LEAD</strong><p>{identity.intro}</p></div></div><div class="intro-footer" data-intro><span>SCROLL TO EXPLORE ↓</span><span>DESIGNED TO EVOLVE</span></div></section><section class="hero wrap" data-assemble><div class="hero-copy"><p class="eyebrow">ARTIFICIAL INTELLIGENCE · DIGITAL INNOVATION</p><h1>Francesco<br/>Custureri <em>AI Lead.</em></h1><p class="hero-lead">{identity.intro}</p><div class="actions"><a class="button primary" href={pathTo('projects/')}>Scopri i progetti <span>↗</span></a><a class="button secondary" href={pathTo('articles/')}>Leggi gli articoli</a></div><div class="hero-caption"><span class="pulse"></span> AI · Engineering · Research</div></div><div class="hero-art" aria-hidden="true"><div class="hero-monogram"><img src={pathTo('brand/monogram-color.svg')} alt="" /></div><div class="halo halo-one"></div><div class="halo halo-two"></div><div class="globe"><div class="globe-lines"></div></div><div class="spark s1"></div><div class="spark s2"></div><div class="spark s3"></div><div class="spark s4"></div><span class="art-label l1">INTELLIGENCE / 01</span><span class="art-label l2">SYSTEMS / 02</span></div></section><section class="expertise wrap" data-assemble aria-label="Aree di interesse"><div class="expertise-item"><span class="expertise-icon">◈</span><div><strong>AI & Machine Learning</strong><p>Modelli, agenti e applicazioni reali.</p></div></div><div class="expertise-item"><span class="expertise-icon">⌘</span><div><strong>Digital Infrastructure</strong><p>Reti, osservabilità e sistemi complessi.</p></div></div><div class="expertise-item"><span class="expertise-icon">◇</span><div><strong>Innovation & Research</strong><p>Strategia, sperimentazione e nuove prospettive.</p></div></div></section><section class="section wrap" data-assemble><div class="section-heading"><div><p class="eyebrow">WRITING / IDEE & PROSPETTIVE</p><h2>Ultimi articoli<span class="dot">.</span></h2></div><a class="text-link" href={pathTo('articles/')}>Tutti gli articoli ↗</a></div><div class="articles-grid">{articles.map((article,i)=><ArticleCard article={article} featured={i===0}/>)}</div></section><section class="section wrap" data-assemble><div class="section-heading"><div><p class="eyebrow">SELECTED WORK / PROGETTI</p><h2>Dalle idee ai sistemi<span class="dot">.</span></h2></div><a class="text-link" href={pathTo('projects/')}>Tutti i progetti ↗</a></div><div class="projects-grid">{projects.map((project,i)=><a class="project-card" href={pathTo(`projects/${project.id}/`)}><span class="project-index">0{i+1} / PROJECT</span><div class="project-symbol" aria-hidden="true">{['◎','⌁','◈'][i%3]}</div><h3>{project.data.title}</h3><p>{project.data.description}</p><div class="tags">{project.data.tags.map(tag=><span>{tag}</span>)}</div><span class="read-more">Approfondisci ↗</span></a>)}</div></section><section class="contact-strip wrap" data-assemble><div><p class="eyebrow">LET'S CONNECT</p><h2>Costruiamo nuove idee.</h2><p>Collaborazioni, confronto e nuove prospettive sull'AI.</p></div><a class="button primary" href={pathTo('contact/')}>Contatti ↗</a></section><script>
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (!reduced) {
    const animate = (selector: string, keyframes: Keyframe[], delay: number, duration = 700) => {
      document.querySelectorAll<HTMLElement>(selector).forEach((el, index) => el.animate(keyframes, { duration, delay: delay + index * 110, easing: 'cubic-bezier(.22,1,.36,1)', fill: 'both' }));
    };
    animate('.intro-grid', [{opacity:0},{opacity:1}], 0, 500);
    animate('.intro-grid i', [{transform:'scaleY(0)',transformOrigin:'top'},{transform:'scaleY(1)',transformOrigin:'top'}], 80, 800);
    animate('.intro-top', [{opacity:0,transform:'translateY(-14px)'},{opacity:1,transform:'translateY(0)'}], 300);
    animate('.intro-mark', [{opacity:0,transform:'scale(.7) rotate(-12deg)'},{opacity:1,transform:'scale(1) rotate(0deg)'}], 420, 850);
    animate('.intro-kicker', [{opacity:0,transform:'translateY(20px)'},{opacity:1,transform:'translateY(0)'}], 580);
    animate('.intro-line > span', [{transform:'translateY(115%)'},{transform:'translateY(0)'}], 710, 950);
    animate('.intro-bottom', [{opacity:0,transform:'translateY(28px)'},{opacity:1,transform:'translateY(0)'}], 1080);
    animate('.intro-footer', [{opacity:0},{opacity:1}], 1350);
    const observer = new IntersectionObserver(entries => entries.forEach(entry => {
      if (!entry.isIntersecting) return;
      const el = entry.target as HTMLElement;
      el.animate([{opacity:0,transform:'translateY(65px)'},{opacity:1,transform:'translateY(0)'}], {duration:950,easing:'cubic-bezier(.22,1,.36,1)'});
      observer.unobserve(el);
    }), {threshold:.12});
    document.querySelectorAll('[data-assemble]').forEach(el => observer.observe(el));
    const progress = document.querySelector<HTMLElement>('.assembly-progress span');
    let ticking = false;
    const updateProgress = () => {
      const available = document.documentElement.scrollHeight - window.innerHeight;
      if (progress) progress.style.transform = `scaleX(${available > 0 ? Math.min(1,Math.max(0,window.scrollY/available)) : 0})`;
      ticking = false;
    };
    window.addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(updateProgress); } }, {passive:true});
    updateProgress();
  }
</script></Base>
