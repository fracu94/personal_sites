---
import Base from '../layouts/Base.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { getCollection } from 'astro:content';
import { identity, pathTo } from '../config';
const articles = (await getCollection('articles', ({data})=> !data.draft)).sort((a,b)=>b.data.pubDate.valueOf()-a.data.pubDate.valueOf()).slice(0,3);
const projects = (await getCollection('projects', ({data})=> !data.draft)).slice(0,3);
---
<Base><section class="hero wrap"><div class="hero-copy"><p class="eyebrow">ARTIFICIAL INTELLIGENCE · DIGITAL INNOVATION</p><h1>Francesco<br/>Custureri <em>AI Lead.</em></h1><p class="hero-lead">{identity.intro}</p><div class="actions"><a class="button primary" href={pathTo('projects/')}>Scopri i progetti <span>↗</span></a><a class="button secondary" href={pathTo('articles/')}>Leggi gli articoli</a></div><div class="hero-caption"><span class="pulse"></span> AI · Engineering · Research</div></div><div class="hero-art" aria-hidden="true"><div class="hero-monogram"><img src={pathTo('brand/monogram-color.svg')} alt="" /></div><div class="halo halo-one"></div><div class="halo halo-two"></div><div class="globe"><div class="globe-lines"></div></div><div class="spark s1"></div><div class="spark s2"></div><div class="spark s3"></div><div class="spark s4"></div><span class="art-label l1">INTELLIGENCE / 01</span><span class="art-label l2">SYSTEMS / 02</span></div></section><section class="expertise wrap" aria-label="Aree di interesse"><div class="expertise-item"><span class="expertise-icon">◈</span><div><strong>AI & Machine Learning</strong><p>Modelli, agenti e applicazioni reali.</p></div></div><div class="expertise-item"><span class="expertise-icon">⌘</span><div><strong>Digital Infrastructure</strong><p>Reti, osservabilità e sistemi complessi.</p></div></div><div class="expertise-item"><span class="expertise-icon">◇</span><div><strong>Innovation & Research</strong><p>Strategia, sperimentazione e nuove prospettive.</p></div></div></section><section class="section wrap"><div class="section-heading"><div><p class="eyebrow">WRITING / IDEE & PROSPETTIVE</p><h2>Ultimi articoli<span class="dot">.</span></h2></div><a class="text-link" href={pathTo('articles/')}>Tutti gli articoli ↗</a></div><div class="articles-grid">{articles.map((article,i)=><ArticleCard article={article} featured={i===0}/>)}</div></section><section class="section wrap"><div class="section-heading"><div><p class="eyebrow">SELECTED WORK / PROGETTI</p><h2>Dalle idee ai sistemi<span class="dot">.</span></h2></div><a class="text-link" href={pathTo('projects/')}>Tutti i progetti ↗</a></div><div class="projects-grid">{projects.map((project,i)=><a class="project-card" href={pathTo(`projects/${project.id}/`)}><span class="project-index">0{i+1} / PROJECT</span><div class="project-symbol" aria-hidden="true">{['◎','⌁','◈'][i%3]}</div><h3>{project.data.title}</h3><p>{project.data.description}</p><div class="tags">{project.data.tags.map(tag=><span>{tag}</span>)}</div><span class="read-more">Approfondisci ↗</span></a>)}</div></section><section class="contact-strip wrap"><div><p class="eyebrow">LET'S CONNECT</p><h2>Costruiamo nuove idee.</h2><p>Collaborazioni, confronto e nuove prospettive sull'AI.</p></div><a class="button primary" href={pathTo('contact/')}>Contatti ↗</a></section></Base>
